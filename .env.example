# Supabase project (Settings → API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SECRET. Never prefix with NEXT_PUBLIC_, never commit it,
# never put it in a client component. Only used inside app/api/admin/upload/route.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin photo manager. Pick something you don't reuse elsewhere.
ADMIN_PASSWORD=change-me

# Random long string used to sign admin session cookies. Generate one with:
# openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-too
